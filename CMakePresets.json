{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (MSVC + WDK)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "RINGO_BUILD_DRIVER": "ON",
        "RINGO_BUILD_CLIENT": "ON",
        "RINGO_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "index",
      "displayName": "compile_commands.json para clangd (Ninja + MSVC, solo LSP)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-index",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows",
      "configuration": "Release"
    }
  ]
}
